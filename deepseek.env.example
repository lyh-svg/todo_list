# ===== DeepSeek 配置模板 =====
# 用法: 复制本文件为 deepseek.env 并填写真实值:
#   cp deepseek.env.example deepseek.env
# deepseek.env 已被 .gitignore 排除, 不会提交到仓库。
# 只需要修改下一行。
DEEPSEEK_API_KEY=sk-在此填写你的密钥

# 如果 DeepSeek 控制台给出的模型 ID 不同, 在这里修改。
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# 默认官方地址通常无需修改。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选: 自定义完整 API 地址(优先级高于 BASE_URL)。
# DEEPSEEK_API_URL=
